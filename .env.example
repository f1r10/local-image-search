# Choose lite (demo), gemini (recommended with key), or dinov2 (CPU, optional dependencies)
IMAGE_PROVIDER=lite
GEMINI_API_KEY=
# REQUIRED for write endpoints; generate: openssl rand -hex 32
ADMIN_TOKEN=
DATA_DIR=/srv/data
MAX_PRODUCTS=500
TORCH_NUM_THREADS=2

# CPU Colab pipeline (use with compose.cpu.yaml; not required for Lite/Gemini)
IMAGE_PROVIDER_CPU=dinov2-yolo-torch
YOLO_CROP_MODE=auto
YOLO_MIN_CONF=0.35
YOLO_MIN_AREA=0.02
# Comma-separated eligible COCO labels. Empty means safe built-in list (no wristwatch/person).
YOLO_CROP_CLASSES=
EMBEDDING_CONCURRENCY=1
